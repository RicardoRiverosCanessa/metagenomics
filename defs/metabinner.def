Bootstrap: docker
From: condaforge/miniforge3:latest

%labels
    Author Ricardo Riveros
    Tool MetaBinner
    Version 1.4.4

%post
    set -e
    export LC_ALL=C
    export CONDA_PKGS_DIRS=/tmp/conda-pkgs
    mkdir -p /tmp/conda-pkgs

    apt-get update && apt-get install -y --no-install-recommends \
        git wget ca-certificates procps && \
        rm -rf /var/lib/apt/lists/*

    # 1. Crear /opt/env únicamente con las dependencias reales de MetaBinner
    mamba create -y -p /opt/env --copy \
        -c conda-forge -c bioconda \
        python=3.9 \
        fraggenescan \
        hmmer \
        scikit-learn \
        biopython \
        pandas \
        numpy \
        scipy \
        tqdm && \
        mamba clean -afy

    # 2. Clonar MetaBinner directamente en /opt/metabinner
    git clone --depth 1 https://github.com/ziyewang/MetaBinner.git /opt/metabinner

    # 3. Dar permisos de ejecución a scripts y binarios auxiliares
    chmod -R +x /opt/metabinner/run_metabinner.sh /opt/metabinner/scripts /opt/metabinner/auxiliary

    # 4. Enlazar run_metabinner.sh y scripts dentro de /opt/env/bin para que MBPATH funcione
    ln -sf /opt/metabinner/run_metabinner.sh /opt/env/bin/run_metabinner.sh
    ln -sf /opt/metabinner/scripts /opt/env/bin/scripts
    ln -sf /opt/metabinner/auxiliary /opt/env/bin/auxiliary

    rm -rf /tmp/conda-pkgs

%environment
    export LC_ALL=C
    export PATH="/opt/env/bin:/opt/metabinner:/opt/metabinner/scripts:/opt/metabinner/auxiliary:/opt/conda/bin:${PATH}"
    export METABINNER_SCRIPTS_DIR="/opt/metabinner/scripts"
    export METABINNER_RUNNER="/opt/env/bin/run_metabinner.sh"

%test
    /opt/env/bin/python --version
    which run_metabinner.sh
    test -f /opt/metabinner/scripts/Filter_tooshort.py
    test -f /opt/metabinner/scripts/gen_kmer.py
